{
	"compilerOptions": {
		"strict": true,
		"types": ["node"],
		"module": "commonjs",
		"declaration": true,
		"removeComments": false,
		"emitDecoratorMetadata": true,
		"experimentalDecorators": true,
		"declarationMap": false,
		"target": "es2022",
		"sourceMap": false,
		"outDir": "./dist",
		"rootDir": "./src"
	},
	"include": ["src"],
	"exclude": ["node_modules", "dist", "test"]
}
