{
	"name": "@nestlab/google-recaptcha",
	"version": "3.12.0",
	"description": "Google recaptcha module for NestJS.",
	"keywords": [
		"nestjs",
		"recaptcha",
		"google recaptcha",
		"nestjs recaptcha"
	],
	"private": false,
	"main": "index.js",
	"scripts": {
		"build": "rm -rf dist && tsc && cp package.json dist && cp README.md dist && cp LICENSE dist && cp CONTRIBUTING.md dist && cp CHANGELOG.md dist",
		"format": "prettier \"**/*.ts\" \"**/*.json\" --ignore-path ./.prettierignore --write",
		"format:check": "prettier \"**/*.ts\" \"**/*.json\" --ignore-path ./.prettierignore --check",
		"lint:fix": "eslint . --fix",
		"lint:check": "eslint . --max-warnings=0",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:types": "tsc -p tsconfig.spec.json",
		"publish-package": "cd dist && npm publish --access public"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chvarkov/google-recaptcha.git"
	},
	"author": "Alexey Chvarkov",
	"license": "MIT",
	"bugs": {
		"url": "https://github.com/chvarkov/google-recaptcha/issues"
	},
	"homepage": "https://github.com/chvarkov/google-recaptcha",
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"axios": "^1.21.1"
	},
	"peerDependencies": {
		"@nestjs/common": ">=8.0.0 <13.0.0",
		"@nestjs/core": ">=8.0.0 <13.0.0",
		"@nestjs/graphql": ">=8.0.0 <15.0.0"
	},
	"peerDependenciesMeta": {
		"@nestjs/graphql": {
			"optional": true
		}
	},
	"devDependencies": {
		"@as-integrations/express5": "^1.1.2",
		"@eslint/js": "^10.0.1",
		"@nestjs/apollo": "^14.2.1",
		"@nestjs/axios": "^12.0.2",
		"@nestjs/common": "^12.6.0",
		"@nestjs/core": "^12.6.0",
		"@nestjs/graphql": "^14.2.1",
		"@nestjs/mercurius": "^14.2.1",
		"@nestjs/platform-express": "^12.6.0",
		"@nestjs/platform-fastify": "^12.6.0",
		"@nestjs/platform-node": "^12.6.0",
		"@nestjs/testing": "^12.6.0",
		"@swc/core": "^1.16.22",
		"@types/express": "^5.0.6",
		"@types/node": "^20.19.43",
		"@types/supertest": "^7.2.1",
		"@typescript-eslint/eslint-plugin": "^8.73.0",
		"@typescript-eslint/parser": "^8.73.0",
		"@vitest/coverage-v8": "^4.1.12",
		"eslint": "^10.15.0",
		"express": "^5.3.0",
		"fastify": "^5.12.8",
		"graphql": "^16.15.0",
		"mercurius": "^16.12.2",
		"prettier": "^3.10.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"supertest": "^7.3.2",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"typescript": "^6.0.3",
		"unplugin-swc": "^2.0.0",
		"vitest": "^4.1.12"
	}
}
